---
interface Props {
  title: string
  desc?: string
  type?: 'website' | 'article'
  image?: string
}

const {
  title,
  desc = 'Py:Start — интерактивный учебник по программированию на языке Python',
  type = 'website',
  image = `${import.meta.env.BASE_URL}og-image.jpg`,
} = Astro.props

const currentUrl = Astro.url.pathname
const fullTitle = `Py:Start | ${title}`
const siteUrl = `https://zheny179.github.io${currentUrl}`
---

<meta
  name='description'
  content={desc}
/>

<!-- Open Graph -->
<meta
  property='og:title'
  content={fullTitle}
/>
<meta
  property='og:description'
  content={desc}
/>
<meta
  property='og:image'
  content={image}
/>
<meta
  property='og:type'
  content={type}
/>
<meta
  property='og:url'
  content={siteUrl}
/>
<meta
  property='og:site_name'
  content='Py:Start'
/>
<meta
  property='og:locale'
  content='ru_RU'
/>

<!-- Twitter Card -->
<meta
  name='twitter:card'
  content='summary_large_image'
/>
<meta
  name='twitter:title'
  content={fullTitle}
/>
<meta
  name='twitter:description'
  content={desc}
/>
<meta
  name='twitter:image'
  content={image}
/>

<!-- Canonical URL -->
<link
  rel='canonical'
  href={siteUrl}
/>
