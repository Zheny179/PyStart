---
import type { CollectionEntry } from 'astro:content'
import './LessonNav.scss'

interface Props {
  lesson: CollectionEntry<'lessons'>
  prev?: CollectionEntry<'lessons'> | null
  next?: CollectionEntry<'lessons'> | null
}

const { lesson, prev, next } = Astro.props

const base_url = import.meta.env.BASE_URL

const makeHref = (lesson) => `${base_url}lessons/${lesson.id}/`

const isNewChapterNext =
  next !== null && next?.data.chapter !== lesson.data.chapter

const isNewChapterPrev =
  prev !== null && prev?.data.chapter !== lesson.data.chapter
---

<nav
  class="lesson-nav"
  aria-label="Навигация по урокам"
>
  {
    prev && (
      <a
        class:list={[
          'lesson-nav__link',
          'lesson-nav__link--prev',
          { 'lesson-nav__link--chapter': isNewChapterPrev },
        ]}
        href={makeHref(prev)}
        rel="prev"
      >
        <span class="lesson-nav__direction">
          {isNewChapterPrev
            ? `← Предыдущая глава: ${prev.data.chapter}`
            : '← Назад'}
        </span>
        <span class="lesson-nav__title">{prev.data.title}</span>
      </a>
    )
  }

  {
    next ? (
      <a
        class:list={[
          'lesson-nav__link',
          'lesson-nav__link--next',
          { 'lesson-nav__link--chapter': isNewChapterNext },
        ]}
        href={makeHref(next)}
        rel="next"
      >
        <span class="lesson-nav__direction">
          {isNewChapterNext
            ? `Следующая глава: ${next.data.chapter} →`
            : 'Далее →'}
        </span>
        <span class="lesson-nav__title">{next.data.title}</span>
      </a>
    ) : (
      <a
        class="lesson-nav__link lesson-nav__link--next lesson-nav__link--finish"
        href={`${base_url}lessons/`}
      >
        <span class="lesson-nav__direction">Учебник завершён</span>
        <span class="lesson-nav__title">Все уроки</span>
      </a>
    )
  }
</nav>
