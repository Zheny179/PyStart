---
import './Navigation.scss'
import Content from '@/components/Navigation/Content/Content.astro'
import ButtonMenu from '@/components/ButtonMenu/ButtonMenu.astro'

interface Lesson {
  label: string
  href: string
  isActive?: boolean
}

interface ContentData {
  isActive?: boolean
  href: string
  label: string
}

interface Props {
  className?: string
  mode?: 'chapters' | 'contents'
  content?: ContentData[]
}

const { className, content = [], mode } = Astro.props

const isContents = mode === 'contents'
---

<aside
  class:list={[
    'navigation',
    className,
    {
      'navigation--contents': isContents,
    },
  ]}
  data-navigation=''
>
  <header class:list={['navigation__header']}>
    <ButtonMenu
      className='navigation__btn'
      mode='white'
      extraAttrs={{
        'data-navigation-button': '',
        ariaLabel: 'Свернуть панель',
      }}
    />

    <span class='h3 navigation__title'>Содержание</span>

    <ButtonMenu
      className='navigation__btn'
      mode='contents'
      extraAttrs={{
        'data-navigation-button': '',
        ariaLabel: 'Свернуть панель',
      }}
    />
  </header>

  <nav class='navigation__nav'>
    <Content content={content} />
  </nav>
</aside>

<script>
  import InitNavigation from '@/components/Navigation/Navigation'

  InitNavigation()
</script>
